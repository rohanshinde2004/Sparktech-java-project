[Unit]
Description=Sparktech Demo Service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/opt/sparktech-demo
ExecStart=/usr/bin/java -jar /opt/sparktech-demo/app.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
